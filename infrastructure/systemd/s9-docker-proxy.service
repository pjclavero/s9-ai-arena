# R-DEPLOY · R2 / RC2 — proxy de la API de Docker de S9 AI Arena (HOST).
#
# ÚNICO proceso autorizado a tocar /var/run/docker.sock. Ningún contenedor del
# stack monta el socket (R1.7 · ERR-SEC-02): los consumidores (tournament-worker,
# bot-build-worker y arena-engine, los miembros de la red `bot-control`) lanzan
# contenedores de bots exclusivamente a través de ESTE proxy, con allowlist estricta.
# Ver docs/operations/docker-proxy.md.
#
# RC2: el proxy escucha SÓLO en el gateway de la red Docker dedicada `bot-control`
# (bridge `s9-botctl0`, 10.89.250.1). Nunca 0.0.0.0, nunca docker0, nunca host-gateway.
# Tres capas independientes: red dedicada interna, firewall de host
# (s9-firewall.service, docs/operations/firewall.md) y control de cliente en el proxy.
#
# TD-062 (frontera de privilegio): el proceso tiene el grupo `docker` (= root en el host),
# así que TODO lo que ejecuta o lee como política es de root y no lo puede escribir el
# usuario de despliegue ni un contenedor, incluidos sus directorios padre hasta /:
#   - código: bundle autocontenido /usr/local/lib/s9-docker-proxy/docker-proxy.mjs
#     (root:root 0644; sin node_modules, sin tsx/npx), ejecutado por /usr/bin/node;
#   - allowlist: /etc/s9-docker-proxy/DIGESTS.lock (root:root 0644, copia verificada);
#   - config: /etc/s9-ai-arena/docker-proxy.env (root:root 0640); esta unidad (root 0644).
# El árbol de despliegue (/opt/s9-ai-arena) NO es autoridad: ni WorkingDirectory ni ruta
# ejecutada, y el proceso no lo ve (InaccessiblePaths). Lo comprueba
# /usr/local/sbin/s9-docker-proxy-preflight (copia de root que instala `install`; falla si
# cualquier pieza o un padre no es de root).
#
# Instalación/validación/rollback: infrastructure/scripts/install-docker-proxy.sh

[Unit]
Description=S9 AI Arena · proxy de la API de Docker (allowlist, sólo red bot-control)
Documentation=file:///opt/s9-ai-arena/docs/operations/docker-proxy.md
After=docker.service network-online.target s9-firewall.service
Requires=docker.service
Wants=network-online.target s9-firewall.service
# Reintento acotado si el bridge tarda (ver ExecStartPre): como mucho 10 arranques en 10 min.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# Usuario dedicado SIN privilegios de root; debe pertenecer al grupo `docker`
# para leer el socket. Lo crea install-docker-proxy.sh.
User=s9proxy
Group=docker
# Sin WorkingDirectory: el de un servicio de sistema es `/` (nunca el árbol de /opt).
# Ficheros que pudiera crear el proceso: sólo para él.
UMask=0077
# Config del operador: bind, puerto, bridge, clientes, allowlist de imágenes, red arena,
# usuario del sandbox. Ver infrastructure/systemd/docker-proxy.env.example.
EnvironmentFile=/etc/s9-ai-arena/docker-proxy.env
# Ninguna variable puede inyectar código en node ni en el enlazador (aunque el fichero de
# entorno sea de root; check-env y preflight también las rechazan).
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_REPL_EXTERNAL_MODULE LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
# Fail-closed antes de escuchar:
#   1. DOCKER_PROXY_BIND ni vacío, ni comodín, ni loopback; el bridge no es docker0.
#   2. Espera acotada (DOCKER_PROXY_BRIDGE_WAIT × 2 s; defecto 60, tope 80 para no
#      superar TimeoutStartSec) a que el bridge dedicado exista y tenga la IP del bind:
#      lo crea Docker al restaurar la red `s9-bot-control`, poco después de arrancar.
#      Sin esto el bind fallaría con EADDRNOTAVAIL en el arranque de la máquina.
#   3. La IP del bind no puede estar en docker0.
# Mismo convenio que el proceso: configuración inválida ⇒ exit 78; bridge no listo ⇒ exit 1.
# (`$$` = `$` literal para el shell: systemd no expande esas variables.)
ExecStartPre=/bin/sh -ec '\
  b="$${DOCKER_PROXY_BIND:-}"; br="$${DOCKER_PROXY_BRIDGE:-s9-botctl0}"; n="$${DOCKER_PROXY_BRIDGE_WAIT:-60}"; \
  case "$$b" in ""|0.0.0.0|::|"[::]"|127.*|localhost) echo "s9-docker-proxy: DOCKER_PROXY_BIND inválido: [$$b]" >&2; exit 78;; esac; \
  case "$$br" in ""|docker0|lo) echo "s9-docker-proxy: DOCKER_PROXY_BRIDGE inválido: [$$br]" >&2; exit 78;; esac; \
  case "$$n" in ""|*[!0-9]*) echo "s9-docker-proxy: DOCKER_PROXY_BRIDGE_WAIT inválido: [$$n]" >&2; exit 78;; esac; \
  [ "$$n" -le 80 ] || n=80; \
  i=0; until ip -4 -o addr show dev "$$br" 2>/dev/null | grep -qF " $$b/"; do \
    i=$$((i+1)); [ "$$i" -le "$$n" ] || { echo "s9-docker-proxy: $$br no tiene $$b tras $$n intentos" >&2; exit 1; }; sleep 2; done; \
  if ip -4 -o addr show dev docker0 2>/dev/null | grep -qF " $$b/"; then echo "s9-docker-proxy: $$b es de docker0" >&2; exit 78; fi'
# Artefacto INSTALADO (TD-062), no el árbol: node del sistema + bundle de root. Sin npx/tsx.
# --no-addons: el bundle no carga módulos nativos; ningún .node puede entrar.
ExecStart=/usr/bin/node --no-addons /usr/local/lib/s9-docker-proxy/docker-proxy.mjs
Restart=always
RestartSec=5
# Códigos del proceso (docker-proxy-main.ts): 78 = configuración inválida (EX_CONFIG) ⇒
# NO se reintenta (un bucle no lo arreglaría); 1 = bind fallido (p. ej. el bridge aún no
# tiene la IP) ⇒ sí se reintenta, acotado por StartLimit*.
RestartPreventExitStatus=78
# Debe superar la espera máxima de ExecStartPre (80 × 2 s = 160 s).
TimeoutStartSec=180
# Logs claros por journald (el proxy ya emite JSON por stdout con cada decisión).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=s9-docker-proxy

# Endurecimiento (defensa en profundidad: este proceso media el acceso a Docker). Cada
# opción, por lo que el proxy necesita (TD-062 · S6; docs/operations/docker-proxy.md):
# - sin capacidades: corre como s9proxy; sólo necesita el socket (permiso de grupo).
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
# - sistema de ficheros: todo de sólo lectura salvo el socket; /home y el árbol invisibles.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# - /dev mínimo (null, zero, urandom…): no usa dispositivos.
PrivateDevices=true
# - núcleo, reloj, hostname, cgroups y /proc ajeno: no los toca.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
# - red: TCP (escucha), UNIX (socket de Docker) y NETLINK (sólo `ip addr show` del
#   ExecStartPre y os.networkInterfaces(); sin CAP_NET_ADMIN no puede cambiar nada).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
# - llamadas al sistema: las de un servicio normal, sólo la ABI nativa; una llamada
#   filtrada devuelve EPERM (no mata el proceso: libuv tiene alternativas).
SystemCallArchitectures=native
#   NO se añade ~@privileged: `ip` (ExecStartPre) suelta capacidades con capset() y, con
#   EPERM, sale con 1 y el bridge «nunca» aparece (medido en CI, run 39672952774, y
#   reproducido con systemd-run; lo vigila docker-proxy-privilege.test.ts «U · sandbox real»).
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# - V8 (JIT) necesita memoria W+X: MemoryDenyWriteExecute=true rompe node. Declarado.
MemoryDenyWriteExecute=false
# El socket de Docker es lo ÚNICO escribible.
ReadWritePaths=/var/run/docker.sock
# Código y allowlist instalados: de sólo lectura también para el proceso.
ReadOnlyPaths=/usr/local/lib/s9-docker-proxy /etc/s9-docker-proxy
# El árbol de despliegue no es autoridad del proxy: ni lo lee (`-` = no falla si no existe).
InaccessiblePaths=-/opt/s9-ai-arena

[Install]
WantedBy=multi-user.target
