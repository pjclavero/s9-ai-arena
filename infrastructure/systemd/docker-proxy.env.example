# R-DEPLOY · R2 / RC2 — configuración del proxy de la API de Docker (HOST).
# Copiar a /etc/s9-ai-arena/docker-proxy.env (root:root 0640) y ajustar. Lo lee la unidad
# systemd s9-docker-proxy.service (EnvironmentFile). Validar con:
#   sudo bash infrastructure/scripts/install-docker-proxy.sh check-env /etc/s9-ai-arena/docker-proxy.env
#
# Contrato RC2: el proxy escucha SÓLO en el gateway de la red Docker dedicada `bot-control`
# (nombre Docker `s9-bot-control`, bridge `s9-botctl0`, 10.89.250.0/24). Los consumidores
# lo alcanzan como http://docker-proxy.internal:2375 (extra_hosts → 10.89.250.1).
# Ver docs/operations/docker-proxy.md y docs/operations/firewall.md.

# Dirección de escucha: el gateway de `bot-control`. PROHIBIDO 0.0.0.0, ::, loopback, la
# IP de docker0 o host-gateway: la unidad, `check-env` y el propio proceso lo rechazan
# (fail-closed; el proceso sale con 78 = configuración inválida y systemd no reintenta).
DOCKER_PROXY_BIND=10.89.250.1
DOCKER_PROXY_PORT=2375

# Bridge del host al que pertenece DOCKER_PROXY_BIND. La unidad espera a que exista y
# tenga esa IP antes de arrancar (DOCKER_PROXY_BRIDGE_WAIT intentos × 2 s; tope 80).
DOCKER_PROXY_BRIDGE=s9-botctl0
DOCKER_PROXY_BRIDGE_WAIT=60

# Clientes admitidos por IP de origen (CIDR): sólo la subred de `bot-control`.
# OBLIGATORIO si el bind no es loopback. Una conexión de otro origen recibe 403
# («cliente no autorizado») y se cierra; queda en el log.
DOCKER_PROXY_ALLOWED_CLIENTS=10.89.250.0/24

# Allowlist de imágenes (opcional; por defecto runtimes/DIGESTS.lock del árbol desde el
# que corre el proxy, que es este mismo fichero en /opt/s9-ai-arena): SÓLO la 3ª columna (imagen de runtime
# `repo@sha256:…`, coincidencia exacta). La imagen base (2ª columna) NO se permite.
DOCKER_PROXY_IMAGE_ALLOWLIST=/opt/s9-ai-arena/runtimes/DIGESTS.lock

# (Opcional.) Identidad de esta instancia en la label `s9.proxy.instance` que el proxy impone en cada
# contenedor que crea (junto a `s9.managed=true`); start/stop/json/stats la exigen.
DOCKER_PROXY_INSTANCE=s9-docker-proxy

# Socket de Docker del host (único punto de contacto real con Docker).
DOCKER_SOCKET=/var/run/docker.sock

# Red Docker en la que el proxy permite crear contenedores de bots (allowlist).
# DEBE llamarse literalmente `arena`: compliance.mjs (fuente de verdad, compartida con
# el escáner del Compose) exige ese nombre exacto. El Compose la declara con
# `name: arena` para que NO se prefije con el nombre del proyecto. Los bots NO están en
# `bot-control` y NO alcanzan el proxy.
ARENA_NETWORK=arena

# Usuario:grupo con el que el proxy fuerza a correr los contenedores de bots.
SANDBOX_USER=10001:10001
